# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Editors and OS files
.vscode/
.idea/
.DS_Store

# API keys are read from the environment (GEMINI_API_KEY); never commit them
.env
.env.*

